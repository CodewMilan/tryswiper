# Copy to .env at the repo root and to apps/web/.env.local for Next.js.
# Production sets these on the host. Do not commit real values.

# Postgres. Managed databases should include ?sslmode=require.
# Prefer the pooled connection string when the host provides one.
DATABASE_URL=postgres://swiper:swiper@localhost:54329/swiper

# Public origin, no trailing slash. Production must be https://your-domain.
APP_URL=http://localhost:3100

# Clerk. From the Clerk dashboard API keys page.
# Enable Google and GitHub under Configure → SSO connections. Both are used.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# User lifecycle webhook: https://<your-domain>/api/webhooks/clerk
# Subscribe to user.created, user.updated, user.deleted in Clerk.
CLERK_WEBHOOK_SIGNING_SECRET=

# Optional. Read by the browser bundle at build time.
# Leave unset in the image so the browser uses the origin it loaded.
NEXT_PUBLIC_APP_URL=http://localhost:3100

# Optional. If both are empty, generation uses the local planner.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Read by the local MCP process. Remote Cursor, Claude, and ChatGPT use /mcp instead.
SWIPER_API_URL=http://localhost:3100
SWIPER_API_KEY=

# Dodo Payments. Checkout stays off until the API key, product id, and webhook secret are set.
# Use test_mode until you are ready to charge. live_mode uses live.dodopayments.com.
# Webhook URL: https://<your-domain>/api/v1/billing/webhook
DODO_PAYMENTS_API_KEY=
# Legacy alias for the Pro product; prefer the explicit Pro variable below.
DODO_PAYMENTS_PRODUCT_ID=
# USD, recurring monthly, tax-exclusive; no trial, PPP or automatic price discount.
# Pro: 2900 cents/month. Studio: 7900 cents/month. Use distinct product IDs.
DODO_PAYMENTS_PRO_PRODUCT_ID=
DODO_PAYMENTS_STUDIO_PRODUCT_ID=
DODO_PAYMENTS_WEBHOOK_SECRET=
DODO_PAYMENTS_ENVIRONMENT=test_mode

# Public prices and allowances live in apps/web/src/lib/plans.ts.
# Checkout refuses provider products that disagree with that catalogue.

# Operator-approved public HTTPS policy destinations. Leave unset until approved.
SWIPER_PRIVACY_POLICY_URL=
SWIPER_TERMS_URL=
