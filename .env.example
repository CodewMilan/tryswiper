# Copy to .env at the repo root and to apps/web/.env.local for Next.js.
# Production sets these on the host. Do not commit real values.

# Postgres. Managed databases should include ?sslmode=require.
# Prefer the pooled connection string when the host provides one.
DATABASE_URL=postgres://swiper:swiper@localhost:54329/swiper

# openssl rand -base64 32
# Rejected in production if left as the placeholder or shorter than 32 characters.
BETTER_AUTH_SECRET=replace-with-a-long-random-secret

# Public origin, no trailing slash. Production must be https://your-domain.
BETTER_AUTH_URL=http://localhost:3100
APP_URL=http://localhost:3100

# Optional. Read by the browser bundle at build time.
# Leave unset in the image so the browser uses the origin it loaded.
NEXT_PUBLIC_APP_URL=http://localhost:3100

# Optional. If both are empty, generation uses the local planner.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Read by the MCP process on the machine running the agent, not by the web server.
SWIPER_API_URL=http://localhost:3100
SWIPER_API_KEY=
